# === Bot-Account (zum Chatten) ===
# Der Twitch-Account, den der Bot benutzt (z.B. atlaxx_bot)
BOT_USERNAME=atlaxx_tv
# OAuth-Token fuer den Bot-Account, Format: oauth:xxxxxxxxxxxxxxxx
# Holen via https://twitchtokengenerator.com (Scopes: chat:read chat:edit)
BOT_OAUTH_TOKEN=oauth:6c3m2h9qf8tthfpc0xtjsh8k5avrxq

# === Kanal, in dem der Bot laufen soll ===
CHANNEL_NAME=atlaxx_tv

# === App Credentials (fuer Helix API: Uptime, Followage etc.) ===
# Erstellen unter https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=t32kqkuxj7ko4c2571jmn7tjbvn3eq
TWITCH_CLIENT_SECRET=7hyja44jozu7y9dnpq17fb33xjufjr

# === Moderations-Account (fuer Timeouts/Bans via Helix API) ===
# Muss ein Moderator (oder der Broadcaster) im Kanal sein.
# Access + Refresh Token via OAuth Authorization-Code-Flow holen,
# Scopes: moderator:manage:banned_users moderator:manage:chat_messages
MOD_USER_ID=123456789
BROADCASTER_USER_ID=987654321
MOD_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOD_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Sonstiges ===
DISCORD_INVITE=https://discord.gg/deininvite
# Kommagetrennte Liste an Usernamen, die zusaetzlich als Bot-Admin gelten (Broadcaster ist immer Admin)
EXTRA_ADMINS=
